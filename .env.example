# Copy this file to .env (or just export these before starting the server).
# Everything here is optional; the defaults are fine for a local demo.

# Where campus.db (and any old Part 1 JSON files) live.
CC_DATA_DIR=data

# Folder served as the website.
CC_FRONTEND_DIR=../frontend

# TCP port to listen on.
CC_PORT=8080

# Only allow sign-up with this email domain. Leave empty to allow any domain.
# CC_EMAIL_DOMAIN=geu.ac.in

# Set to 1 when the site is served over HTTPS, so the cookie is marked Secure.
# CC_COOKIE_SECURE=0

# Creates the first admin account if no admin exists yet. Ignored afterwards.
# CC_ADMIN_EMAIL=admin@geu.ac.in
# CC_ADMIN_NAME=Lost & Found Desk
# CC_ADMIN_PASSWORD=choose-a-long-password

# --- email (Phase 3) -------------------------------------------------------
# console: print emails (including links) to the server console - works offline
# brevo:   send real email through Brevo's free plan (300/day)
# CC_MAIL_MODE=console
# CC_BREVO_API_KEY=

# Base URL used inside emailed links. Must be the address users open.
# Defaults to http://localhost:<CC_PORT>.
# CC_BASE_URL=http://localhost:8080

# Sender identity shown in emails (verify the address in Brevo first).
# CC_MAIL_FROM=no-reply@yourdomain.example
# CC_MAIL_FROM_NAME=CampusConnect

# --- rate limiting (Phase 4) ------------------------------------------------
# Counters live in SQLite and survive restarts. Leave this unset unless a reverse
# proxy you control forwards requests (then X-Forwarded-For can be trusted).
# CC_TRUST_PROXY=0

# --- HTTPS (Phase 5) --------------------------------------------------------
# Set both when the site is served over HTTPS (e.g. behind Caddy):
#   CC_COOKIE_SECURE=1   marks the session cookie Secure
#   CC_HSTS=1            sends Strict-Transport-Security
# Never enable CC_HSTS while testing over plain HTTP.
# CC_HSTS=0
